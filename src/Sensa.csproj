<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <Compile Include="../unity/top.sealoong.sensa/Runtime/SensaPoseProtocol.cs" Link="Signals/SensaPoseProtocol.cs" />
    <EmbeddedResource Include="web/data/osc-presets.json" LogicalName="Sensa.OscPresets.json" />
    <Content Remove="web\**" />
    <Content Include="web\index.html;web\styles.css;web\app.bundle.js;web\app.bundle.js.LEGAL.txt" ExcludeFromSingleFile="true" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Remove="web\**" />
    <Compile Remove="web\**" />

  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Buttplug" Version="5.0.0" />
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <AssemblyName>Sensa</AssemblyName>
    <Version>0.4.0</Version>
    <RootNamespace>Sensa</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAuditMode>all</NuGetAuditMode>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\..\artifacts\**</DefaultItemExcludes>
  </PropertyGroup>

  <Target Name="BuildWeb" BeforeTargets="PrepareForBuild" Condition="'$(SkipWebBuild)' != 'true'">
    <Exec Command="npm run build:web" WorkingDirectory="$(MSBuildProjectDirectory)/.." />
  </Target>

</Project>
