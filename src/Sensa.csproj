<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <Compile Include="../unity/top.sealoong.sensa/Runtime/SensaPoseProtocol.cs" Link="Signals/SensaPoseProtocol.cs" />
    <Compile Include="../unity/top.sealoong.sensa/Runtime/SensaContactProtocol.cs" Link="Signals/SensaContactProtocol.cs" />
    <Compile Include="../unity/top.sealoong.sensa/Runtime/SensaFixedAnchorProtocol.cs" Link="Signals/SensaFixedAnchorProtocol.cs" />
    <EmbeddedResource Include="web/data/osc-presets.json" LogicalName="Sensa.OscPresets.json" />
    <InternalsVisibleTo Include="Sensa.Tests" />
    <Content Remove="web\**" />
    <Content Include="web\index.html;web\styles.css" ExcludeFromSingleFile="true" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="web\app.bundle.js;web\app.bundle.js.LEGAL.txt;web\realtime-worker.bundle.js" Condition="'$(SkipWebBuild)' != 'true'" ExcludeFromSingleFile="true" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\docs\parameter-geometry.html" Link="web\docs\parameter-geometry.html" ExcludeFromSingleFile="true" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\docs\assets\osc-parameter-reference.js;..\docs\assets\parameter-geometry-model.js;..\docs\assets\parameter-geometry-view.js;..\docs\assets\parameter-geometry-style.css;..\docs\assets\parameter-geometry-3d.js;..\docs\assets\parameter-geometry-3d.LICENSE.txt" Link="web\docs\assets\%(Filename)%(Extension)" ExcludeFromSingleFile="true" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Remove="web\**" />
    <Compile Remove="web\**" />

  </ItemGroup>

  <!-- A single-file download contains its Web UI and interactive guide. Native
       libraries may extract to .NET's cache; settings stay beside the executable. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishSingleFile)' == 'true'">
    <EmbeddedResource Include="web/index.html;web/styles.css" LogicalName="Sensa.Web.%(Filename)%(Extension)" />
    <EmbeddedResource Include="web/app.bundle.js;web/app.bundle.js.LEGAL.txt;web/realtime-worker.bundle.js" Condition="'$(SkipWebBuild)' != 'true'" LogicalName="Sensa.Web.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../docs/parameter-geometry.html" LogicalName="Sensa.Web.docs.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../docs/assets/osc-parameter-reference.js;../docs/assets/parameter-geometry-model.js;../docs/assets/parameter-geometry-view.js;../docs/assets/parameter-geometry-style.css;../docs/assets/parameter-geometry-3d.js;../docs/assets/parameter-geometry-3d.LICENSE.txt" LogicalName="Sensa.Web.docs.assets.%(Filename)%(Extension)" />
    <Content Update="web/**;../docs/parameter-geometry.html;../docs/assets/*" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Buttplug" Version="5.0.1" />
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.13" />
    <PackageReference Include="System.Management" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <AssemblyName>Sensa</AssemblyName>
    <Version>0.4.0</Version>
    <RootNamespace>Sensa</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Keep the analyzer/tool dependency identical in portable and single-file restores. -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <NuGetAuditMode>all</NuGetAuditMode>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\..\artifacts\**</DefaultItemExcludes>
  </PropertyGroup>

  <Target Name="BuildWeb" BeforeTargets="PrepareForBuild" Condition="'$(SkipWebBuild)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm run build:web" WorkingDirectory="$(MSBuildProjectDirectory)/.." />
  </Target>

</Project>
