[
  {
    "id": "sensa-quick-start",
    "name": "入门 · 测试世界 → 我的 Avatar",
    "description": "配合 Avatar 的 Quick Start World Receiver 和世界 START HERE 操作台。无需 SPS、相机或 Python。阶梯测试预期 0/25/50/75/100%，Active 为门控；Stop 关闭门控。只验证链路，不表示 SPS 深度。",
    "mappings": [
      {"oscPath": "Sensa/QuickStart/Depth", "role": "Depth", "vrchatMin": 0, "vrchatMax": 1},
      {"oscPath": "Sensa/QuickStart/Active", "role": "GateEnable"}
    ]
  },
  {
    "id": "sensa-pose-depth",
    "name": "Sensa Pose · 几何深度",
    "description": "配套三标记 / 24 接收器。使用轴线与孔口平面的交点求插入比例。丢失或无效时停止，不回退旧 OGB。",
    "mappings": [
      {
        "oscPath": "Sensa/Pose/v1/*/*/**",
        "sourceMode": "SensaPose",
        "poseMetric": "Depth",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 1
      }
    ]
  },
  {
    "id": "sensa-pose-full",
    "name": "Sensa Pose · 六轴（需校准）",
    "description": "同一对象的深度、偏航、俯仰、扭转与孔口 X/Y 偏移。X/Y 映射到 L2/L1；必须按设备安装方向检查轴与反向。",
    "mappings": [
      {
        "oscPath": "Sensa/Pose/v1/*/*/**",
        "sourceMode": "SensaPose",
        "poseMetric": "Depth",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 1
      },
      {
        "oscPath": "Sensa/Pose/v1/*/*/**",
        "sourceMode": "SensaPose",
        "poseMetric": "Yaw",
        "role": "AngleX",
        "vrchatMin": -65,
        "vrchatMax": 65
      },
      {
        "oscPath": "Sensa/Pose/v1/*/*/**",
        "sourceMode": "SensaPose",
        "poseMetric": "Pitch",
        "role": "AngleY",
        "vrchatMin": -65,
        "vrchatMax": 65
      },
      {
        "oscPath": "Sensa/Pose/v1/*/*/**",
        "sourceMode": "SensaPose",
        "poseMetric": "Roll",
        "role": "Twist",
        "vrchatMin": -180,
        "vrchatMax": 180
      },
      {
        "oscPath": "Sensa/Pose/v1/*/*/**",
        "sourceMode": "SensaPose",
        "poseMetric": "OffsetX",
        "role": "Sway",
        "vrchatMin": -0.04,
        "vrchatMax": 0.04
      },
      {
        "oscPath": "Sensa/Pose/v1/*/*/**",
        "sourceMode": "SensaPose",
        "poseMetric": "OffsetY",
        "role": "Surge",
        "vrchatMin": -0.04,
        "vrchatMax": 0.04
      }
    ]
  },
