[
  {
    "id": "sensa-pose-depth",
    "name": "Sensa Pose · 几何深度",
    "description": "配套三标记 / 24 接收器。使用轴线与孔口平面的交点求插入比例。丢失或无效时停止，不回退旧 OGB。",
    "mappings": [
      {
        "oscPath": "Sensa/Pose/v1/*/*/**",
        "sourceMode": "SensaPose",
        "poseMetric": "Depth",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 1
      }
    ]
  },
  {
    "id": "sensa-pose-full",
    "name": "Sensa Pose · 六轴（需校准）",
    "description": "同一对象的深度、偏航、俯仰、扭转与孔口 X/Y 偏移。X/Y 映射到 L2/L1；必须按设备安装方向检查轴与反向。",
    "mappings": [
      {
        "oscPath": "Sensa/Pose/v1/*/*/**",
        "sourceMode": "SensaPose",
        "poseMetric": "Depth",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 1
      },
      {
        "oscPath": "Sensa/Pose/v1/*/*/**",
        "sourceMode": "SensaPose",
        "poseMetric": "Yaw",
        "role": "AngleX",
        "vrchatMin": -65,
        "vrchatMax": 65
      },
      {
        "oscPath": "Sensa/Pose/v1/*/*/**",
        "sourceMode": "SensaPose",
        "poseMetric": "Pitch",
        "role": "AngleY",
        "vrchatMin": -65,
        "vrchatMax": 65
      },
      {
        "oscPath": "Sensa/Pose/v1/*/*/**",
        "sourceMode": "SensaPose",
        "poseMetric": "Roll",
        "role": "Twist",
        "vrchatMin": -180,
        "vrchatMax": 180
      },
      {
        "oscPath": "Sensa/Pose/v1/*/*/**",
        "sourceMode": "SensaPose",
        "poseMetric": "OffsetX",
        "role": "Sway",
        "vrchatMin": -0.04,
        "vrchatMax": 0.04
      },
      {
        "oscPath": "Sensa/Pose/v1/*/*/**",
        "sourceMode": "SensaPose",
        "poseMetric": "OffsetY",
        "role": "Surge",
        "vrchatMin": -0.04,
        "vrchatMax": 0.04
      }
    ]
  },
  {
    "id": "sps-socket-depth",
    "name": "VRCFury SPS · Socket 新深度",
    "description": "NewRoot/NewTip 成对计算深度，按同一来源、同一孔位配对。先从外部靠近一次以估算长度；未校准时保持零。需在 VRCFury 中启用 Haptics/OGB。",
    "mappings": [
      {
        "oscPath": "OGB/Orf/**/PenOthersNewRoot;OGB/Orf/**/PenOthersNewTip",
        "sourceMode": "SpsSocketDepth",
        "role": "Depth",
        "isOgbSocket": true
      },
      {
        "oscPath": "OGB/Orf/**/PenSelfNewRoot;OGB/Orf/**/PenSelfNewTip",
        "sourceMode": "SpsSocketDepth",
        "role": "Depth",
        "isOgbSocket": true
      }
    ]
  },
  {
    "id": "sps-plug-depth",
    "name": "VRCFury SPS · Plug 深度",
    "description": "VRCFury 根部接收器：PenOthers/PenSelf 值越大表示越深，默认不反向。旧 Sensa 尖端接收器请使用旧 OGB Plug 预设并校准。",
    "mappings": [
      {
        "oscPath": "OGB/Pen/**/PenOthers;OGB/Pen/**/PenSelf",
        "role": "Depth",
        "isOgbPlug": true
      }
    ]
  },
  {
    "id": "ogb-socket-full",
    "name": "OGB Socket · 深度 + 姿态",
    "description": "利用通配匹配任意 OGB Socket 孔位。深度使用完整行程；左右/上下姿态分别映射到 0-500 / 500-999 两段位置区间。",
    "mappings": [
      {
        "oscPath": "OGB/Orf/**/PenOthers",
        "role": "Depth",
        "isOgbSocket": true
      },
      {
        "oscPath": "OGB/Orf/**/AngleRight_Raw",
        "role": "AngleX",
        "mappedMin": 500,
        "mappedMax": 999,
        "isOgbSocket": true
      },
      {
        "oscPath": "OGB/Orf/**/AngleLeft_Raw",
        "role": "AngleX",
        "mappedMin": 0,
        "mappedMax": 500,
        "isOgbSocket": true
      },
      {
        "oscPath": "OGB/Orf/**/AngleUp_Raw",
        "role": "AngleY",
        "mappedMin": 500,
        "mappedMax": 999,
        "isOgbSocket": true
      },
      {
        "oscPath": "OGB/Orf/**/AngleDown_Raw",
        "role": "AngleY",
        "mappedMin": 0,
        "mappedMax": 500,
        "isOgbSocket": true
      }
    ]
  },
  {
    "id": "ogb-plug-full",
    "name": "OGB Plug · 深度（插入 / 自插）",
    "description": "Plug 方标准深度参数，同时映射 PenOthers(插入他人)和 PenSelf(自插)。深度自动反向。",
    "mappings": [
      {
        "oscPath": "OGB/Pen/*/PenOthers",
        "role": "Depth",
        "invertDirection": true,
        "isOgbPlug": true
      },
      {
        "oscPath": "OGB/Pen/*/PenSelf",
        "role": "Depth",
        "invertDirection": true,
        "isOgbPlug": true
      }
    ]
  },
  {
    "id": "ogb-plug-others",
    "name": "OGB Plug · 仅插入他人",
    "description": "仅映射 PenOthers(插入他人深度)，不包含自插。",
    "mappings": [
      {
        "oscPath": "OGB/Pen/*/PenOthers",
        "role": "Depth",
        "invertDirection": true,
        "isOgbPlug": true
      }
    ]
  },
  {
    "id": "ogb-plug-self",
    "name": "OGB Plug · 仅自插",
    "description": "仅映射 PenSelf(自插深度)。需在 Sensa 组件中启用 generateSelfParam。",
    "mappings": [
      {
        "oscPath": "OGB/Pen/*/PenSelf",
        "role": "Depth",
        "invertDirection": true,
        "isOgbPlug": true
      }
    ]
  },
  {
    "id": "osr-inserted-pussy",
    "name": "OSR-VRChat · 被插入（小穴）",
    "description": "OGB/Orf/Pussy/PenOthers 插入深度（仅 Depth 单轴）。直接参考 OSR-VRChat。",
    "mappings": [
      {
        "oscPath": "OGB/Orf/Pussy/PenOthers",
        "role": "Depth",
        "isOgbSocket": true
      }
    ]
  },
  {
    "id": "osr-inserted-ass",
    "name": "OSR-VRChat · 被插入（后庭）",
    "description": "OGB/Orf/Ass/PenOthers 插入深度（仅 Depth 单轴）。直接参考 OSR-VRChat。",
    "mappings": [
      {
        "oscPath": "OGB/Orf/Ass/PenOthers",
        "role": "Depth",
        "isOgbSocket": true
      }
    ]
  },
  {
    "id": "sps-touch",
    "name": "VRCFury SPS · 触碰与摩擦",
    "description": "TouchSelf/TouchOthers/FrotOthers 映射振动 V0。Close 是接触开关，NewRoot/NewTip 是距离信号，不作为普通深度别名。",
    "mappings": [
      {
        "oscPath": "OGB/**/TouchOthers;OGB/**/TouchSelf;OGB/**/FrotOthers",
        "role": "V0"
      }
    ]
  },
  {
    "id": "sensa-aux",
    "name": "Sensa · 辅助信号",
    "description": "按新版 Unity 组件生成的角色路径匹配。GateEnable 无值或关闭时停止输出；多个门控规则必须都开启。ExistingParameter 需手动填写路径。",
    "mappings": [
      {
        "oscPath": "Sensa/**/Vibrate;Sensa/**/Vibrate_Angle;Sensa/**/Vibrate_Stretch;Sensa/**/Vibrate_Squish;Sensa/**/Vibrate_IsGrabbed;Sensa/**/Vibrate_Ratio",
        "role": "V0"
      },
      {
        "oscPath": "Sensa/**/GateEnable;Sensa/**/GateEnable_Angle;Sensa/**/GateEnable_Stretch;Sensa/**/GateEnable_Squish;Sensa/**/GateEnable_IsGrabbed;Sensa/**/GateEnable_Hit",
        "role": "GateEnable"
      },
      {
        "oscPath": "Sensa/**/DepthOverride;Sensa/**/DepthOverride_Angle;Sensa/**/DepthOverride_Stretch;Sensa/**/DepthOverride_Squish;Sensa/**/DepthOverride_IsGrabbed;Sensa/**/DepthOverride_Ratio",
        "role": "DepthOverride"
      },
      {
        "oscPath": "Sensa/**/AngleX;Sensa/**/AngleX_Angle;Sensa/**/AngleX_Stretch;Sensa/**/AngleX_Squish;Sensa/**/AngleX_IsGrabbed;Sensa/**/AngleX_Ratio",
        "role": "AngleX"
      },
      {
        "oscPath": "Sensa/**/AngleY;Sensa/**/AngleY_Angle;Sensa/**/AngleY_Stretch;Sensa/**/AngleY_Squish;Sensa/**/AngleY_IsGrabbed;Sensa/**/AngleY_Ratio",
        "role": "AngleY"
      }
    ]
  }
]
