  {
    "id": "osc-l0",
    "group": "标准预设",
    "name": "OSC 参数 → L0 主轴",
    "description": "Depth 只是示例路径。换成实际收到的参数后，输入 0～1 对应主轴的预估位置 0～999。",
    "mappings": [
      {
        "oscPath": "Depth",
        "sourceMode": "Direct",
        "role": "Depth"
      }
    ]
  },
  {
    "id": "ogb-depth-touch",
    "group": "标准预设",
    "name": "SPS 深度 → L0，触碰 → V0（需振动输出）",
    "description": "主轴跟随 SPS 深度，振动输出跟随触碰强度。分别校准主轴行程和振动强度。",
    "mappings": [
      {
        "oscPath": "OGB/Orf/**/PenOthersNewRoot;OGB/Orf/**/PenOthers;OGB/Pen/**/PenOthers;OGB/Socket/**/DepthOthers;OGB/Plug/**/DepthOthers",
        "sourceMode": "OgbDepth",
        "role": "Depth"
      },
      {
        "oscPath": "OGB/Orf/**/TouchOthers;OGB/Orf/**/FrotOthers;OGB/Pen/**/TouchOthers;OGB/Pen/**/FrotOthers;VFH/Zone/Touch/**/Others;OGB/Socket/**/TouchOthers;OGB/Plug/**/TouchOthers;OGB/Plug/**/FrotOthers;OGB/Touch/**/Others",
        "role": "V0",
        "sourceMode": "OgbTouch"
      }
    ]
  },
  {
    "id": "ogb-touch",
    "group": "标准预设",
    "name": "SPS 触碰 → V0（需振动输出）",
    "description": "正式 SPS3 的 TouchOthers／FrotOthers 直接控制 V0；只有旧版需要时才配对同一对象的 Close。",
    "mappings": [
      {
        "oscPath": "OGB/Orf/**/TouchOthers;OGB/Orf/**/FrotOthers;OGB/Pen/**/TouchOthers;OGB/Pen/**/FrotOthers;VFH/Zone/Touch/**/Others;OGB/Socket/**/TouchOthers;OGB/Plug/**/TouchOthers;OGB/Plug/**/FrotOthers;OGB/Touch/**/Others",
        "role": "V0",
        "sourceMode": "OgbTouch"
      }
    ]
  },
  {
    "id": "native-contact-speed",
    "group": "标准预设",
    "name": "Contact 相对速率 → V0（需振动输出）",
    "description": "相对速率 0～1 m/s → V0；任意方向移动越快，振动目标越强。两行使用同一接收器参数名，SenderType 门控作用于整组轴映射。",
    "mappings": [
      {
        "oscPath": "MyContact_SenderVelocityMagnitude",
        "sourceMode": "Direct",
        "role": "V0",
        "vrchatMin": 0,
        "vrchatMax": 1
      },
      {
        "oscPath": "MyContact_SenderType",
        "sourceMode": "Direct",
        "role": "GateEnable",
        "vrchatMin": 0,
        "vrchatMax": 1
      }
    ]
  },
  {
    "id": "contact-speed",
    "group": "标准预设",
    "name": "Contact 自身定位速率 → V0（需振动输出）",
    "description": "自己装了 Sensa Contact 自身定位组件。左右、上下、前后运动都会带来振动，静止时回到零。把 Root 换成自己的实例，按舒适速度校准 V0，并允许实验空间输入。",
    "mappings": [
      {
        "oscPath": "Sensa/Contact/Root/*",
        "sourceMode": "SensaPoint",
        "pointMetric": "Speed",
        "role": "V0",
        "vrchatMin": 0,
        "vrchatMax": 1
      }
    ]
  }
]
