[
  {
    "id": "ogb-depth",
    "group": "我和对方用 SPS，自己只收到深度或触碰",
    "name": "仅前后跟随",
    "description": "左右移动时，只有 SPS 深度可能让主轴误退。沿入口直进直退校准两端。正式 SPS3 读取 DepthOthers，旧版识别 PenOthers 或 NewRoot／NewTip。",
    "mappings": [
      {
        "oscPath": "OGB/Orf/**/PenOthersNewRoot;OGB/Orf/**/PenOthers;OGB/Pen/**/PenOthers;OGB/Socket/**/DepthOthers;OGB/Plug/**/DepthOthers",
        "sourceMode": "OgbDepth",
        "role": "Depth"
      }
    ],
    "setup": "只有 SPS 深度"
  },
  {
    "id": "ogb-depth-touch",
    "group": "我和对方用 SPS，自己只收到深度或触碰",
    "name": "标准 · 前后跟随，触碰时振动",
    "description": "同时需要主轴和振动时可选。主轴跟随 SPS 深度，触碰强度控制振动。左右偏移也可能改变深度。用同一对象试一次直进直退，分别校准两条映射。",
    "mappings": [
      {
        "oscPath": "OGB/Orf/**/PenOthersNewRoot;OGB/Orf/**/PenOthers;OGB/Pen/**/PenOthers;OGB/Socket/**/DepthOthers;OGB/Plug/**/DepthOthers",
        "sourceMode": "OgbDepth",
        "role": "Depth"
      },
      {
        "oscPath": "OGB/Orf/**/TouchOthers;OGB/Orf/**/FrotOthers;OGB/Pen/**/TouchOthers;OGB/Pen/**/FrotOthers;VFH/Zone/Touch/**/Others;OGB/Socket/**/TouchOthers;OGB/Plug/**/TouchOthers;OGB/Plug/**/FrotOthers;OGB/Touch/**/Others",
        "role": "V0",
        "sourceMode": "OgbTouch"
      }
    ]
  },
  {
    "id": "sps-soft-entry",
    "group": "我和对方用 SPS，自己只收到深度或触碰",
    "name": "浅碰时让主轴少动",
    "description": "只有 SPS 时，轻轻擦过容易带动主轴。接近读数前 20% 保持在起点，之后逐渐加大行程。浅层的真实前后动作也会减弱，深处侧移仍可能引起回退。",
    "mappings": [
      {
        "oscPath": "OGB/Orf/**/PenOthersNewRoot;OGB/Orf/**/PenOthers;OGB/Pen/**/PenOthers;OGB/Socket/**/DepthOthers;OGB/Plug/**/DepthOthers",
        "sourceMode": "OgbDepth",
        "role": "Depth",
        "vrchatMin": 0.2,
        "curve": "EaseIn"
      }
    ],
    "setup": "只有 SPS 深度"
  },
  {
    "id": "ogb-touch",
    "group": "我和对方用 SPS，自己只收到深度或触碰",
    "name": "仅触碰振动",
    "description": "正式 SPS3 的 TouchOthers／FrotOthers 直接控制 V0；只有旧版需要时才配对同一对象的 Close。",
    "mappings": [
      {
        "oscPath": "OGB/Orf/**/TouchOthers;OGB/Orf/**/FrotOthers;OGB/Pen/**/TouchOthers;OGB/Pen/**/FrotOthers;VFH/Zone/Touch/**/Others;OGB/Socket/**/TouchOthers;OGB/Plug/**/TouchOthers;OGB/Plug/**/FrotOthers;OGB/Touch/**/Others",
        "role": "V0",
        "sourceMode": "OgbTouch"
      }
    ]
  },
  {
    "id": "native-contact-axial",
    "group": "我的 Contact 已启用高级报告",
    "name": "左右晃动时保持主轴位置",
    "description": "自己的接收器已上报高级位置和 SenderType，对方只需有它能识别的 Sender。把两行 MyContact 换成同一接收器名，将接收器 Z 对准进退方向，校准浅端和深端。整组映射在失去接触时停止。",
    "mappings": [
      {
        "oscPath": "MyContact_SenderLocalPositionZ",
        "sourceMode": "Direct",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 0.2
      },
      {
        "oscPath": "MyContact_SenderType",
        "sourceMode": "Direct",
        "role": "GateEnable",
        "vrchatMin": 0,
        "vrchatMax": 1
      }
    ],
    "setup": "我的接收器启用了 Contact 高级位置"
  },
  {
    "id": "native-contact-approach",
    "group": "我的 Contact 已启用高级报告",
    "name": "原生 Contact · 接近时振动",
    "description": "仅 Proximity 接收器。接近值每秒增加 0～2 → V0；不变或减小时为零。两行使用同一接收器参数名，SenderType 门控作用于整组轴映射。",
    "mappings": [
      {
        "oscPath": "MyContact_ProximitySpeed",
        "sourceMode": "Direct",
        "role": "V0",
        "vrchatMin": 0,
        "vrchatMax": 2
      },
      {
        "oscPath": "MyContact_SenderType",
        "sourceMode": "Direct",
        "role": "GateEnable",
        "vrchatMin": 0,
        "vrchatMax": 1
      }
    ]
  },
  {
    "id": "native-contact-speed",
    "group": "我的 Contact 已启用高级报告",
    "name": "移动越快，振动越强",
    "description": "相对速率 0～1 m/s → V0；任意方向移动越快，振动目标越强。两行使用同一接收器参数名，SenderType 门控作用于整组轴映射。",
    "mappings": [
      {
        "oscPath": "MyContact_SenderVelocityMagnitude",
        "sourceMode": "Direct",
        "role": "V0",
        "vrchatMin": 0,
        "vrchatMax": 1
      },
      {
        "oscPath": "MyContact_SenderType",
        "sourceMode": "Direct",
        "role": "GateEnable",
        "vrchatMin": 0,
        "vrchatMax": 1
      }
    ]
  },
  {
    "id": "native-contact-separation",
    "group": "我的 Contact 已启用高级报告",
    "name": "两点拉开时主轴前移",
    "description": "距离 0～0.20 m → L0；参考点越远，目标位置越大。两行的 MyContact 都换成接收器参数名。SenderType 门控作用于整组轴映射。",
    "mappings": [
      {
        "oscPath": "MyContact_PointSeparation",
        "sourceMode": "Direct",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 0.2
      },
      {
        "oscPath": "MyContact_SenderType",
        "sourceMode": "Direct",
        "role": "GateEnable",
        "vrchatMin": 0,
        "vrchatMax": 1
      }
    ]
  },
  {
    "id": "self-contact-stroke",
    "group": "我装了 Sensa 自身定位组件",
    "name": "自身前移带振动，停住时保持位置",
    "description": "选用 Sensa 脚本配置的 Contact 自身定位。主轴跟随 Avatar 根坐标 Z，只有朝正 Z 移动才增强振动，停住后振动归零。两行 Root 换成同一实例，校准位置与速度，并允许实验空间输入。",
    "mappings": [
      {
        "oscPath": "Sensa/Contact/Root/*",
        "sourceMode": "SensaPoint",
        "pointMetric": "Z",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 0.2
      },
      {
        "oscPath": "Sensa/Contact/Root/*",
        "sourceMode": "SensaPoint",
        "pointMetric": "VelocityZ",
        "role": "V0",
        "vrchatMin": 0,
        "vrchatMax": 1
      }
    ]
  },
  {
    "id": "self-four-anchor-axial",
    "group": "我装了 Sensa 自身定位组件",
    "name": "SPS 四点定位 · 只跟随自身前后移动",
    "description": "自己安装了 Sensa 四点定位组件，测量目标在自己的 Avatar 上。左右或上下平移时主轴保持。把 Root 换成目标实例，按 Avatar 根坐标 Z 校准两端，并允许实验空间输入。入口随骨骼转向时，可在计算信号中选“跟随移动平面”。",
    "mappings": [
      {
        "oscPath": "Sensa/SPS/Root/**",
        "sourceMode": "SensaPoint",
        "pointMetric": "Z",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 0.2
      }
    ],
    "setup": "我装了 Sensa 四点定位"
  },
  {
    "id": "contact-position",
    "group": "我装了 Sensa 自身定位组件",
    "name": "用自己的前后位置控制主轴",
    "description": "自己装了 Sensa Contact 自身定位组件。沿 Avatar 根坐标 Z 前后移动，主轴跟随，停住时保持位置。把 Root 换成自己的实例，沿预期方向校准两端，并允许实验空间输入。",
    "mappings": [
      {
        "oscPath": "Sensa/Contact/Root/*",
        "sourceMode": "SensaPoint",
        "pointMetric": "Z",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 0.2
      }
    ],
    "setup": "我装了 Sensa Contact 自身定位"
  },
  {
    "id": "contact-speed",
    "group": "我装了 Sensa 自身定位组件",
    "name": "自己动得越快，振动越强",
    "description": "自己装了 Sensa Contact 自身定位组件。左右、上下、前后运动都会带来振动，静止时回到零。把 Root 换成自己的实例，按舒适速度校准 V0，并允许实验空间输入。",
    "mappings": [
      {
        "oscPath": "Sensa/Contact/Root/*",
        "sourceMode": "SensaPoint",
        "pointMetric": "Speed",
        "role": "V0",
        "vrchatMin": 0,
        "vrchatMax": 1
      }
    ]
  },
  {
    "id": "pose-aligned-depth",
    "group": "双方都装了 Sensa 三点姿态组件",
    "name": "入口转向时仍沿入口测深",
    "description": "自己装 Pose Socket，对方装同通道 Pose Plug。主轴按入口坐标中的进入比例移动；在有效孔口内平行侧移可保持深度，偏离孔口或倾斜过大将失去联动。将 Main 换成自己的 Socket 实例，并允许实验空间输入。",
    "mappings": [
      {
        "oscPath": "Sensa/Pose/v1/Main/Others/**",
        "sourceMode": "SensaPose",
        "poseMetric": "Depth",
        "role": "Depth"
      }
    ],
    "setup": "双方装了配对的 Sensa 姿态组件"
  },
  {
    "id": "osc-l0",
    "group": "通用示例：我知道要用哪个参数",
    "name": "OSC 参数 → L0 主轴",
    "description": "Depth 只是示例路径。换成实际收到的参数后，输入 0～1 对应主轴的预估位置 0～999。",
    "mappings": [
      {
        "oscPath": "Depth",
        "sourceMode": "Direct",
        "role": "Depth"
      }
    ]
  },
  {
    "id": "native-pb-stretch",
    "group": "通用示例：我知道要用哪个参数",
    "name": "抓住并拉伸时控制主轴",
    "description": "自己的 Avatar 会上报 PhysBone 抓取和拉伸时可用。将两行 MyPB 换成同一根骨骼链的参数前缀。抓住后拉得越远，主轴走得越远；松手关闭整组轴映射门控。",
    "mappings": [
      {
        "oscPath": "MyPB_Stretch",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 1
      },
      {
        "oscPath": "MyPB_IsGrabbed",
        "role": "GateEnable"
      }
    ]
  }
]
