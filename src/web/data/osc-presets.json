  {
    "id": "sensa-aux-vibration",
    "name": "Sensa · 辅助振动",
    "description": "只匹配 Unity 中配置的对应辅助角色。Existing Parameter 需替换为实际参数路径。这是标量输入；不要用它解释 Root/SharedRoot 的距离样本。",
    "mappings": [
      {
        "oscPath": "Sensa/**/Vibrate;Sensa/**/Vibrate_Angle;Sensa/**/Vibrate_Stretch;Sensa/**/Vibrate_Squish;Sensa/**/Vibrate_IsGrabbed;Sensa/**/Vibrate_Ratio",
        "role": "V0"
      }
    ]
  },
  {
    "id": "sensa-aux-gate",
    "name": "Sensa · 辅助门控",
    "description": "只匹配 Unity 中配置的对应辅助角色。Existing Parameter 需替换为实际参数路径。没有有效门控值时停止输出，作为其他输入的附加规则使用。",
    "mappings": [
      {
        "oscPath": "Sensa/**/GateEnable;Sensa/**/GateEnable_Angle;Sensa/**/GateEnable_Stretch;Sensa/**/GateEnable_Squish;Sensa/**/GateEnable_IsGrabbed;Sensa/**/GateEnable_Hit",
