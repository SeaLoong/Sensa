[
  {
    "id": "ogb-depth",
    "group": "跟随双方的相对动作",
    "name": "仅前后跟随",
    "description": "主轴随 SPS 深度前后移动。左右晃动也会改变球形接触区的读数，主轴可能随之回退。校准时请对准入口，沿前后方向往返一次。",
    "mappings": [
      {
        "oscPath": "OGB/Orf/**/PenOthersNewRoot;OGB/Orf/**/PenOthers;OGB/Pen/**/PenOthers;OGB/Socket/**/DepthOthers;OGB/Plug/**/DepthOthers",
        "sourceMode": "OgbDepth",
        "role": "Depth"
      }
    ],
    "setup": "我和对方都用 SPS，只读取深度"
  },
  {
    "id": "native-contact-axial",
    "group": "跟随双方的相对动作",
    "name": "左右晃动时保持主轴位置",
    "description": "对方只需有接收器能识别的接触点。将接收器的 Z 轴对准入口，左右晃动时主轴就能保持原位。把两行中的 MyContact 换成同一接收器的参数名，校准行程两端。失去接触时整组停止。",
    "mappings": [
      {
        "oscPath": "MyContact_SenderLocalPositionZ",
        "sourceMode": "Direct",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 0.2
      },
      {
        "oscPath": "MyContact_SenderType",
        "sourceMode": "Direct",
        "role": "GateEnable",
        "vrchatMin": 0,
        "vrchatMax": 1
      }
    ],
    "setup": "我的 Contact 接收器已开启高级位置"
  },
  {
    "id": "native-contact-separation",
    "group": "我的 Contact 已启用高级报告",
    "name": "两点拉开时主轴前移",
    "description": "距离 0～0.20 m → L0；参考点越远，目标位置越大。两行的 MyContact 都换成接收器参数名。SenderType 门控作用于整组轴映射。",
    "mappings": [
      {
        "oscPath": "MyContact_PointSeparation",
        "sourceMode": "Direct",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 0.2
      },
      {
        "oscPath": "MyContact_SenderType",
        "sourceMode": "Direct",
        "role": "GateEnable",
        "vrchatMin": 0,
        "vrchatMax": 1
      }
    ]
  },
  {
    "id": "self-four-anchor-axial",
    "group": "跟随自己身上的定位点",
    "name": "SPS 四点定位 · 只跟随自身前后移动",
    "description": "主轴跟随定位点相对自己 Avatar 的前后移动。将 Root 换成定位点名称，校准行程两端，并启用实验空间输入。",
    "mappings": [
      {
        "oscPath": "Sensa/SPS/Root/**",
        "sourceMode": "SensaPoint",
        "pointMetric": "Z",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 0.2
      }
    ],
    "setup": "我装了 Sensa 的 SPS 四点定位组件"
  },
  {
    "id": "contact-position",
    "group": "跟随自己身上的定位点",
    "name": "用自己的前后位置控制主轴",
    "description": "主轴跟随定位点相对自己 Avatar 的前后移动。将 Root 换成 Sensa Contact 实例名，校准行程两端，并启用实验空间输入。",
    "mappings": [
      {
        "oscPath": "Sensa/Contact/Root/*",
        "sourceMode": "SensaPoint",
        "pointMetric": "Z",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 0.2
      }
    ],
    "setup": "我用 Sensa 脚本配置了 Contact 自身定位"
  },
  {
    "id": "pose-aligned-depth",
    "group": "跟随双方的相对动作",
    "name": "入口转向时仍沿入口测深",
    "description": "入口转向时，主轴仍跟随进入深度。双方的 Socket 和 Plug 需使用同一通道。将 Main 换成 Socket 实例名，并启用实验空间输入。偏出入口或倾斜过大时停止。",
    "mappings": [
      {
        "oscPath": "Sensa/Pose/v1/Main/Others/**",
        "sourceMode": "SensaPose",
        "poseMetric": "Depth",
        "role": "Depth"
      }
    ],
    "setup": "我装了 Pose Socket，对方装了配对的 Pose Plug"
  },
  {
    "id": "osc-l0",
    "group": "通用示例：我知道要用哪个参数",
    "name": "OSC 参数 → L0 主轴",
    "description": "Depth 只是示例路径。换成实际收到的参数后，输入 0～1 对应主轴的预估位置 0～999。",
    "mappings": [
      {
        "oscPath": "Depth",
        "sourceMode": "Direct",
        "role": "Depth"
      }
    ]
  },
  {
    "id": "native-pb-stretch",
    "group": "通用示例：我知道要用哪个参数",
    "name": "抓住并拉伸时控制主轴",
    "description": "自己的 Avatar 会上报 PhysBone 抓取和拉伸时可用。将两行 MyPB 换成同一根骨骼链的参数前缀。抓住后拉得越远，主轴走得越远；松手关闭整组轴映射门控。",
    "mappings": [
      {
        "oscPath": "MyPB_Stretch",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 1
      },
      {
        "oscPath": "MyPB_IsGrabbed",
        "role": "GateEnable"
      }
    ]
  },
  {
    "id": "ogb-depth-touch",
    "group": "振动（需设备支持）",
    "name": "SPS 深度与触碰振动",
    "description": "主轴跟随 SPS 深度，振动输出跟随触碰强度。分别校准主轴行程和振动强度。",
    "mappings": [
      {
        "oscPath": "OGB/Orf/**/PenOthersNewRoot;OGB/Orf/**/PenOthers;OGB/Pen/**/PenOthers;OGB/Socket/**/DepthOthers;OGB/Plug/**/DepthOthers",
        "sourceMode": "OgbDepth",
        "role": "Depth"
      },
      {
        "oscPath": "OGB/Orf/**/TouchOthers;OGB/Orf/**/FrotOthers;OGB/Pen/**/TouchOthers;OGB/Pen/**/FrotOthers;VFH/Zone/Touch/**/Others;OGB/Socket/**/TouchOthers;OGB/Plug/**/TouchOthers;OGB/Plug/**/FrotOthers;OGB/Touch/**/Others",
        "role": "V0",
        "sourceMode": "OgbTouch"
      }
    ]
  },
  {
    "id": "ogb-touch",
    "group": "振动（需设备支持）",
    "name": "仅触碰振动",
    "description": "正式 SPS3 的 TouchOthers／FrotOthers 直接控制 V0；只有旧版需要时才配对同一对象的 Close。",
    "mappings": [
      {
        "oscPath": "OGB/Orf/**/TouchOthers;OGB/Orf/**/FrotOthers;OGB/Pen/**/TouchOthers;OGB/Pen/**/FrotOthers;VFH/Zone/Touch/**/Others;OGB/Socket/**/TouchOthers;OGB/Plug/**/TouchOthers;OGB/Plug/**/FrotOthers;OGB/Touch/**/Others",
        "role": "V0",
        "sourceMode": "OgbTouch"
      }
    ]
  },
  {
    "id": "native-contact-approach",
    "group": "振动（需设备支持）",
    "name": "原生 Contact · 接近时振动",
    "description": "仅 Proximity 接收器。接近值每秒增加 0～2 → V0；不变或减小时为零。两行使用同一接收器参数名，SenderType 门控作用于整组轴映射。",
    "mappings": [
      {
        "oscPath": "MyContact_ProximitySpeed",
        "sourceMode": "Direct",
        "role": "V0",
        "vrchatMin": 0,
        "vrchatMax": 2
      },
      {
        "oscPath": "MyContact_SenderType",
        "sourceMode": "Direct",
        "role": "GateEnable",
        "vrchatMin": 0,
        "vrchatMax": 1
      }
    ]
  },
  {
    "id": "native-contact-speed",
    "group": "振动（需设备支持）",
    "name": "移动越快，振动越强",
    "description": "相对速率 0～1 m/s → V0；任意方向移动越快，振动目标越强。两行使用同一接收器参数名，SenderType 门控作用于整组轴映射。",
    "mappings": [
      {
        "oscPath": "MyContact_SenderVelocityMagnitude",
        "sourceMode": "Direct",
        "role": "V0",
        "vrchatMin": 0,
        "vrchatMax": 1
      },
      {
        "oscPath": "MyContact_SenderType",
        "sourceMode": "Direct",
        "role": "GateEnable",
        "vrchatMin": 0,
        "vrchatMax": 1
      }
    ]
  },
  {
    "id": "self-contact-stroke",
    "group": "振动（需设备支持）",
    "name": "自身前移带振动，停住时保持位置",
    "description": "选用 Sensa 脚本配置的 Contact 自身定位。主轴跟随 Avatar 根坐标 Z，只有朝正 Z 移动才增强振动，停住后振动归零。两行 Root 换成同一实例，校准位置与速度，并允许实验空间输入。",
    "mappings": [
      {
        "oscPath": "Sensa/Contact/Root/*",
        "sourceMode": "SensaPoint",
        "pointMetric": "Z",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 0.2
      },
      {
        "oscPath": "Sensa/Contact/Root/*",
        "sourceMode": "SensaPoint",
        "pointMetric": "VelocityZ",
        "role": "V0",
        "vrchatMin": 0,
        "vrchatMax": 1
      }
    ]
  },
  {
    "id": "contact-speed",
    "group": "振动（需设备支持）",
    "name": "自己动得越快，振动越强",
    "description": "自己装了 Sensa Contact 自身定位组件。左右、上下、前后运动都会带来振动，静止时回到零。把 Root 换成自己的实例，按舒适速度校准 V0，并允许实验空间输入。",
    "mappings": [
      {
        "oscPath": "Sensa/Contact/Root/*",
        "sourceMode": "SensaPoint",
        "pointMetric": "Speed",
        "role": "V0",
        "vrchatMin": 0,
        "vrchatMax": 1
      }
    ]
  }
]
