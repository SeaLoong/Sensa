[
  {
    "id": "ogb-depth",
    "name": "OGB / SPS · 深度",
    "description": "自动识别新旧 OGB：Root/Tip 优先，旧版单近接回退；固定实际对象后校准。",
    "mappings": [
      {
        "oscPath": "OGB/Orf/**/PenOthersNewRoot;OGB/Orf/**/PenOthers;OGB/Pen/**/PenOthers",
        "sourceMode": "OgbDepth",
        "role": "Depth"
      }
    ]
  },
  {
    "id": "ogb-touch",
    "name": "OGB / SPS · 振动",
    "description": "Touch / Frot → V0；自动检查同一对象所需的 Close 门控。",
    "mappings": [
      {
        "oscPath": "OGB/Orf/**/TouchOthers;OGB/Orf/**/FrotOthers;OGB/Pen/**/TouchOthers;OGB/Pen/**/FrotOthers",
        "role": "V0",
        "sourceMode": "OgbTouch"
      }
    ]
  },
  {
    "id": "native-pb-stretch",
    "name": "PhysBone · 拉伸",
    "description": "将 MyPB 换成实际参数前缀，再校准 Stretch；松手关闭门控。",
    "mappings": [
      {
        "oscPath": "MyPB_Stretch",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 1
      },
      {
        "oscPath": "MyPB_IsGrabbed",
        "role": "GateEnable"
      }
    ]
  }
]
