[
  {
    "id": "sps-limited",
    "group": "推荐预设",
    "name": "缩小侧移引起的回退 · 普通 SPS",
    "description": "只有普通 SPS 时，左右偏移有时会让主轴误退。这项预设只用中间 40% 行程（300～700），正常进退和误退的幅度都缩小。",
    "mappings": [
      {
        "oscPath": "OGB/Orf/**/PenOthersNewRoot;OGB/Orf/**/PenOthers;OGB/Pen/**/PenOthers;OGB/Socket/**/DepthOthers;OGB/Plug/**/DepthOthers",
        "sourceMode": "OgbDepth",
        "role": "Depth",
        "mappedMin": 300,
        "mappedMax": 700
      }
    ]
  },
  {
    "id": "native-contact-axial",
    "group": "推荐预设",
    "name": "横移时保持深度 · Contact 高级位置",
    "description": "对方只需有接收器能识别的接触点。将接收器的 Z 轴对准入口，左右晃动时主轴就能保持原位。把两行中的 MyContact 换成同一接收器的参数名，校准行程两端。失去接触时整组停止。",
    "mappings": [
      {
        "oscPath": "MyContact_SenderLocalPositionZ",
        "sourceMode": "Direct",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 0.2
      },
      {
        "oscPath": "MyContact_SenderType",
        "sourceMode": "Direct",
        "role": "GateEnable",
        "vrchatMin": 0,
        "vrchatMax": 1
      }
    ]
  },
  {
    "id": "pose-aligned-depth",
    "group": "推荐预设",
    "name": "跟随转动的入口 · 双方 Pose 定位",
    "description": "入口转向时，主轴仍跟随进入深度。双方的 Socket 和 Plug 需使用同一通道。将 Main 换成 Socket 实例名，并启用实验空间输入。偏出入口或倾斜过大时停止。",
    "mappings": [
      {
        "oscPath": "Sensa/Pose/v1/Main/Others/**",
        "sourceMode": "SensaPose",
        "poseMetric": "Depth",
        "role": "Depth"
      }
    ]
  },
  {
    "id": "native-pb-stretch",
    "group": "推荐预设",
    "name": "抓住并拉伸时控制主轴",
    "description": "自己的 Avatar 会上报 PhysBone 抓取和拉伸时可用。将两行 MyPB 换成同一根骨骼链的参数前缀。抓住后拉得越远，主轴走得越远；松手关闭整组轴映射门控。",
    "mappings": [
      {
        "oscPath": "MyPB_Stretch",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 1
      },
      {
        "oscPath": "MyPB_IsGrabbed",
        "role": "GateEnable"
      }
    ]
  },
  {
    "id": "native-contact-approach",
    "group": "推荐预设",
    "name": "原生 Contact · 接近时振动",
    "description": "仅 Proximity 接收器。接近值每秒增加 0～2 → V0；不变或减小时为零。两行使用同一接收器参数名，SenderType 门控作用于整组轴映射。",
    "mappings": [
      {
        "oscPath": "MyContact_ProximitySpeed",
        "sourceMode": "Direct",
        "role": "V0",
        "vrchatMin": 0,
        "vrchatMax": 2
      },
      {
        "oscPath": "MyContact_SenderType",
        "sourceMode": "Direct",
        "role": "GateEnable",
        "vrchatMin": 0,
        "vrchatMax": 1
      }
    ]
  },
  {
    "id": "self-contact-stroke",
    "group": "推荐预设",
    "name": "自身前移带振动，停住时保持位置",
    "description": "选用 Sensa 脚本配置的 Contact 自身定位。主轴跟随 Avatar 根坐标 Z，只有朝正 Z 移动才增强振动，停住后振动归零。两行 Root 换成同一实例，校准位置与速度，并允许实验空间输入。",
    "mappings": [
      {
        "oscPath": "Sensa/Contact/Root/*",
        "sourceMode": "SensaPoint",
        "pointMetric": "Z",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 0.2
      },
      {
        "oscPath": "Sensa/Contact/Root/*",
        "sourceMode": "SensaPoint",
        "pointMetric": "VelocityZ",
        "role": "V0",
        "vrchatMin": 0,
        "vrchatMax": 1
      }
    ]
  },
  {
    "id": "ogb-depth",
    "group": "标准预设",
    "name": "SPS 深度 → L0",
    "description": "沿入口前后移动，L0 应随深度读数增加或减小。普通 SPS 也会受侧移影响，可用这一项对照原始深度反应。",
    "mappings": [
      {
        "oscPath": "OGB/Orf/**/PenOthersNewRoot;OGB/Orf/**/PenOthers;OGB/Pen/**/PenOthers;OGB/Socket/**/DepthOthers;OGB/Plug/**/DepthOthers",
        "sourceMode": "OgbDepth",
        "role": "Depth"
      }
    ]
  },
  {
    "id": "native-contact-xyz",
    "group": "标准预设",
    "name": "Contact 位置 Z/Y/X → L0/L1/L2",
    "description": "将接收器 Z 对准入口，四行 MyContact 填同一参数名。沿接收器 Z、Y、X 依次移动接触点，分别检查主轴、纵向和横向。侧轴零位对应中位；失去接触时整组停止。",
    "mappings": [
      {
        "oscPath": "MyContact_SenderLocalPositionZ",
        "sourceMode": "Direct",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 0.2
      },
      {
        "oscPath": "MyContact_SenderLocalPositionY",
        "sourceMode": "Direct",
        "role": "Surge",
        "vrchatMin": -0.04,
        "vrchatMax": 0.04
      },
      {
        "oscPath": "MyContact_SenderLocalPositionX",
        "sourceMode": "Direct",
        "role": "Sway",
        "vrchatMin": -0.04,
        "vrchatMax": 0.04
      },
      {
        "oscPath": "MyContact_SenderType",
        "sourceMode": "Direct",
        "role": "GateEnable",
        "vrchatMin": 0,
        "vrchatMax": 1
      }
    ]
  },
  {
    "id": "pose-osr2",
    "group": "标准预设",
    "name": "Pose 三轴 → L0/R1/R2（OSR2）",
    "description": "配对 Pose 后，将 Main 换成 Socket 实例名，并允许实验空间输入。保持接触，分别前后移动、左右摆角和上下摆角，依次检查 L0、R1、R2。零角度对应旋转轴中位。",
    "mappings": [
      {
        "oscPath": "Sensa/Pose/v1/Main/Others/**",
        "sourceMode": "SensaPose",
        "poseMetric": "Depth",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 1
      },
      {
        "oscPath": "Sensa/Pose/v1/Main/Others/**",
        "sourceMode": "SensaPose",
        "poseMetric": "Yaw",
        "role": "AngleX",
        "vrchatMin": -65,
        "vrchatMax": 65
      },
      {
        "oscPath": "Sensa/Pose/v1/Main/Others/**",
        "sourceMode": "SensaPose",
        "poseMetric": "Pitch",
        "role": "AngleY",
        "vrchatMin": -65,
        "vrchatMax": 65
      }
    ]
  },
  {
    "id": "pose-six-axis",
    "group": "标准预设",
    "name": "Pose 六轴 → L0/L1/L2/R0/R1/R2",
    "description": "双方配对 Pose 后，将 Main 换成 Socket 实例名，并允许实验空间输入。一次只做一种动作：进入深度 → L0，孔口 Y/X 偏移 → L1/L2，扭转/偏航/俯仰 → R0/R1/R2。保持有效接触，检查方向和中位。",
    "mappings": [
      {
        "oscPath": "Sensa/Pose/v1/Main/Others/**",
        "sourceMode": "SensaPose",
        "poseMetric": "Depth",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 1
      },
      {
        "oscPath": "Sensa/Pose/v1/Main/Others/**",
        "sourceMode": "SensaPose",
        "poseMetric": "Yaw",
        "role": "AngleX",
        "vrchatMin": -65,
        "vrchatMax": 65
      },
      {
        "oscPath": "Sensa/Pose/v1/Main/Others/**",
        "sourceMode": "SensaPose",
        "poseMetric": "Pitch",
        "role": "AngleY",
        "vrchatMin": -65,
        "vrchatMax": 65
      },
      {
        "oscPath": "Sensa/Pose/v1/Main/Others/**",
        "sourceMode": "SensaPose",
        "poseMetric": "Roll",
        "role": "Twist",
        "vrchatMin": -180,
        "vrchatMax": 180
      },
      {
        "oscPath": "Sensa/Pose/v1/Main/Others/**",
        "sourceMode": "SensaPose",
        "poseMetric": "OffsetX",
        "role": "Sway",
        "vrchatMin": -0.04,
        "vrchatMax": 0.04
      },
      {
        "oscPath": "Sensa/Pose/v1/Main/Others/**",
        "sourceMode": "SensaPose",
        "poseMetric": "OffsetY",
        "role": "Surge",
        "vrchatMin": -0.04,
        "vrchatMax": 0.04
      }
    ]
  },
  {
    "id": "native-contact-separation",
    "group": "标准预设",
    "name": "Contact 两点距离 → L0",
    "description": "距离 0～0.20 m → L0；参考点越远，目标位置越大。两行的 MyContact 都换成接收器参数名。SenderType 门控作用于整组轴映射。",
    "mappings": [
      {
        "oscPath": "MyContact_PointSeparation",
        "sourceMode": "Direct",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 0.2
      },
      {
        "oscPath": "MyContact_SenderType",
        "sourceMode": "Direct",
        "role": "GateEnable",
        "vrchatMin": 0,
        "vrchatMax": 1
      }
    ]
  },
  {
    "id": "self-four-anchor-axial",
    "group": "标准预设",
    "name": "SPS 四点定位 Z → L0",
    "description": "主轴跟随定位点相对自己 Avatar 的前后移动。将 Root 换成定位点名称，校准行程两端，并启用实验空间输入。",
    "mappings": [
      {
        "oscPath": "Sensa/SPS/Root/**",
        "sourceMode": "SensaPoint",
        "pointMetric": "Z",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 0.2
      }
    ]
  },
  {
    "id": "self-four-anchor-xyz",
    "group": "标准预设",
    "name": "SPS 四点定位 Y/Z/X → L0/L1/L2",
    "description": "按 Avatar 根坐标验轴：上下（Y）→ L0，前后（Z）→ L1，左右（X）→ L2。三行 Root 换成同一定位点，允许实验空间输入。先采集每个方向的两端，再一次只动一个方向。",
    "mappings": [
      {
        "oscPath": "Sensa/SPS/Root/**",
        "sourceMode": "SensaPoint",
        "pointMetric": "Y",
        "role": "Depth",
        "vrchatMin": 0.9,
        "vrchatMax": 1.1
      },
      {
        "oscPath": "Sensa/SPS/Root/**",
        "sourceMode": "SensaPoint",
        "pointMetric": "Z",
        "role": "Surge",
        "vrchatMin": -0.1,
        "vrchatMax": 0.1
      },
      {
        "oscPath": "Sensa/SPS/Root/**",
        "sourceMode": "SensaPoint",
        "pointMetric": "X",
        "role": "Sway",
        "vrchatMin": -0.1,
        "vrchatMax": 0.1
      }
    ]
  },
