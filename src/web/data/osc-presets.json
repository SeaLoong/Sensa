[
  {
    "id": "sensa-quick-start",
    "name": "链路测试",
    "description": "配合 Sensa 测试世界；Active 关闭时停止。",
    "mappings": [
      {
        "oscPath": "Sensa/QuickStart/Depth",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 1
      },
      {
        "oscPath": "Sensa/QuickStart/Active",
        "role": "GateEnable"
      }
    ]
  },
  {
    "id": "sps-socket-depth-others",
    "name": "SPS Socket · 径向估算",
    "description": "VRCFury NewRoot/NewTip，先从外部靠近校准；不是轴向位置。",
    "mappings": [
      {
        "oscPath": "OGB/Orf/*/PenOthersNewRoot",
        "sourceMode": "SpsSocketDepth",
        "role": "Depth",
        "isOgbSocket": true
      }
    ]
  },
  {
    "id": "sps-plug-depth-others",
    "name": "SPS Plug · 近接",
    "description": "VRCFury 根部近接；数值越大表示越近，默认不反向。",
    "mappings": [
      {
        "oscPath": "OGB/Pen/*/PenOthers",
        "role": "Depth",
        "isOgbPlug": true
      }
    ]
  },
  {
    "id": "sps-touch",
    "name": "OGB · 触碰振动",
    "description": "TouchOthers / FrotOthers → V0。",
    "mappings": [
      {
        "oscPath": "OGB/Orf/*/TouchOthers;OGB/Orf/*/FrotOthers;OGB/Pen/*/TouchOthers;OGB/Pen/*/FrotOthers",
        "role": "V0"
      }
    ]
  },
  {
    "id": "sensa-lab-pb-stretch",
    "name": "PB · 拉伸",
    "description": "测试路径 Sensa/Lab/PB；使用前替换并校准，松手停止。",
    "mappings": [
      {
        "oscPath": "Sensa/Lab/PB_Stretch",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 1
      },
      {
        "oscPath": "Sensa/Lab/PB_IsGrabbed",
        "role": "GateEnable"
      }
    ]
  }
]
