[
  {
    "id": "ogb-depth",
    "name": "OGB / SPS · 深度",
    "description": "自动识别 SPS2 · PenOthersNewRoot / PenOthersNewTip，以及 SPS1 · PenOthers / PenOthersClose。选择要使用的对象后校准动作范围。",
    "mappings": [
      {
        "oscPath": "OGB/Orf/**/PenOthersNewRoot;OGB/Orf/**/PenOthers;OGB/Pen/**/PenOthers",
        "sourceMode": "OgbDepth",
        "role": "Depth"
      }
    ]
  },
  {
    "id": "ogb-touch",
    "name": "OGB / SPS · 振动",
    "description": "Touch / Frot → V0；自动检查同一对象所需的 Close 门控。",
    "mappings": [
      {
        "oscPath": "OGB/Orf/**/TouchOthers;OGB/Orf/**/FrotOthers;OGB/Pen/**/TouchOthers;OGB/Pen/**/FrotOthers;VFH/Zone/Touch/**/Others",
        "role": "V0",
        "sourceMode": "OgbTouch"
      }
    ]
  },
  {
    "id": "contact-position",
    "name": "Contact · 位置（SDK Beta）",
    "description": "专用 Contact 直接定位：将 Root 换成实际对象，选择位置轴并校准两个端点，单位为米。",
    "mappings": [
      {
        "oscPath": "Sensa/Contact/Root/*",
        "sourceMode": "SensaPoint",
        "pointMetric": "Z",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 0.2
      }
    ]
  },
  {
    "id": "contact-speed",
    "name": "Contact · 速度强度（SDK Beta）",
    "description": "专用 Contact 相对速率 → V0；将 Root 换成实际对象，再按 m/s 校准强度范围。",
    "mappings": [
      {
        "oscPath": "Sensa/Contact/Root/*",
        "sourceMode": "SensaPoint",
        "pointMetric": "Speed",
        "role": "V0",
        "vrchatMin": 0,
        "vrchatMax": 1
      }
    ]
  },
  {
    "id": "native-pb-stretch",
    "name": "PhysBone · 拉伸",
    "description": "将 MyPB 换成实际参数前缀，再校准 Stretch；松手关闭门控。",
    "mappings": [
      {
        "oscPath": "MyPB_Stretch",
        "role": "Depth",
        "vrchatMin": 0,
        "vrchatMax": 1
      },
      {
        "oscPath": "MyPB_IsGrabbed",
        "role": "GateEnable"
      }
    ]
  }
]
