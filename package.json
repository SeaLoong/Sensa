  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "ws": "8.22.0"
  },
  "private": true,
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
