{
  "name": "sensa",
  "version": "0.4.0",
  "description": "Local input, signal processing and output workbench for OSC, devices and funscript.",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "test": "npm run lint && node --test tests/web/*.test.mjs",
    "lint": "npm run lint:legacy && npm run lint:typed && npm run typecheck",
    "e2e:ci": "playwright test",
    "e2e:request": "gh workflow run e2e.yml --ref main -f update_snapshots=false",
    "e2e:baselines": "gh workflow run update-e2e.yml --ref main -f mode=screenshots",
    "lint:legacy": "eslint src/web docs/assets/parameter-geometry-model.js docs/assets/parameter-geometry-signal.js docs/assets/parameter-geometry-view.js docs/assets/parameter-geometry-3d-source.js",
    "lint:typed": "oxlint --max-warnings 0 src/core src/node src/electron src/web/ui.tsx src/web/runtime-client.ts src/web/bootstrap.tsx src/web/entry.tsx src/web/workbench-props.ts src/websensa tests/types tests/e2e-types tests/node tests/runtime tests/e2e/parameter-detail-screenshot.ts",
    "typecheck": "npm run typecheck:browser && npm run typecheck:node && npm run typecheck:electron && npm run typecheck:e2e",
    "typecheck:browser": "tsc --project tsconfig.json",
    "typecheck:e2e": "tsc --project tsconfig.e2e-types.json",
    "test:node": "node scripts/test-node.mjs",
    "build:node": "node scripts/build-node.mjs",
    "build:desktop": "npm run build:node -- --bundle-only && node scripts/build-electron.mjs --prepare-only",
    "desktop": "npm run build:desktop && electron artifacts/electron-app",
    "start": "npm run build:node -- --bundle-only && node artifacts/node/sensa.cjs",
    "typecheck:node": "tsc --project tsconfig.node.json",
    "typecheck:electron": "tsc --project tsconfig.electron.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeaLoong/Sensa.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/SeaLoong/Sensa/issues"
  },
  "homepage": "https://github.com/SeaLoong/Sensa#readme",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@mermaid-js/tiny": "12.2.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/w3c-web-serial": "1.0.9",
    "@types/web-bluetooth": "0.0.22",
    "@types/ws": "8.18.2",
    "electron": "45.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "markdown-it": "15.0.3",
    "oxlint": "1.90.0",
    "postject": "1.0.0-alpha.6",
    "typescript": "7.0.2"
  },
  "private": true,
  "dependencies": {
    "bonjour-service": "1.4.4",
    "proper-lockfile": "4.1.2",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=24.22.2"
  },
  "optionalDependencies": {
    "@julusian/midi": "3.8.1",
    "serialport": "13.0.0"
  }
}
