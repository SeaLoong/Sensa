{
  "name": "sensa",
  "version": "0.4.0",
  "description": "Local input, signal processing and output workbench for OSC, devices and funscript.",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "test": "npm run lint && node --test tests/web/*.test.mjs",
    "lint": "npm run lint:legacy && npm run lint:typed && npm run typecheck",
    "e2e:ci": "playwright test",
    "e2e:request": "gh workflow run e2e.yml --ref main -f update_snapshots=false",
    "e2e:baselines": "gh workflow run update-e2e.yml --ref main -f mode=screenshots",
    "lint:legacy": "eslint src/web docs/assets/parameter-geometry-model.js docs/assets/parameter-geometry-signal.js docs/assets/parameter-geometry-view.js docs/assets/parameter-geometry-3d-source.js",
    "lint:typed": "oxlint --max-warnings 0 src/core src/websensa tests/types",
    "typecheck": "tsc --project tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeaLoong/Sensa.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/SeaLoong/Sensa/issues"
  },
  "homepage": "https://github.com/SeaLoong/Sensa#readme",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@mermaid-js/tiny": "12.2.0",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/w3c-web-serial": "1.0.9",
    "@types/web-bluetooth": "0.0.22",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "markdown-it": "15.0.3",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "ws": "8.22.0"
  },
  "private": true,
  "dependencies": {
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "engines": {
    "node": ">=24.19.0"
  }
}
